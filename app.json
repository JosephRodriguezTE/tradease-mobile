{
  "expo": {
    "name": "Tradease",
    "slug": "tradease",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/tradease-icon.png",
    "scheme": "tradease",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/tradeaselogo.png",
      "resizeMode": "contain",
      "backgroundColor": "#0A0A0A"
    },
    "notification": {
      "icon": "./assets/tradease-icon.png",
      "color": "#FF6200",
      "androidMode": "default",
      "androidCollapsedTitle": "Tradease"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.tradease.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Tradease uses your location to find contractors near you and auto-fill your address when booking.",
        "NSLocationAlwaysUsageDescription": "Tradease uses your location to find contractors near you.",
        "UIBackgroundModes": [
          "remote-notification"
        ],
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.tradease.app",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/tradease-icon.png",
        "backgroundColor": "#0A0A0A"
      },
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE",
        "POST_NOTIFICATIONS",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "data": [
            { "scheme": "tradease" }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/tradease-icon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Tradease uses your location to find nearby contractors."
        }
      ],
      "expo-web-browser",
      [
        "expo-notifications",
        {
          "icon": "./assets/tradease-icon.png",
          "color": "#FF6200",
          "defaultChannel": "default"
        }
      ],
      "expo-font",
      "@rnmapbox/maps",
      [
        "@sentry/react-native",
        {
          "organization": "tradease-uo",
          "project": "react-native"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "1f532f3b-ecd1-400a-b2a4-ed108a39edd3"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/1f532f3b-ecd1-400a-b2a4-ed108a39edd3"
    }
  }
}
